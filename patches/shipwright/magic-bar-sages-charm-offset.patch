+        const s16 magicBarY_original_s = R_MAGIC_BAR_SMALL_Y + Y_Margins + trifoolMagicBarOffset;
         const s16 PosX_Start_original = OTRGetRectDimensionFromLeftEdge(R_MAGIC_BAR_X + X_Margins);
