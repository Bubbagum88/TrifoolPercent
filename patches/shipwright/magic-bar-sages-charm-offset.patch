--- a/soh/src/code/z_parameter.c
+++ b/soh/src/code/z_parameter.c
@@ -3447,6 +3447,12 @@
     CLOSE_DISPS(play->state.gfxCtx);
 }

+// TrifoolPercent Beat 2.1 (Sages' Charm). Weak symbol: zero offset in a build
+// without the TrifoolPercent module, 3 (px) once the Charm is held.
+__attribute__((weak)) s16 TrifoolBeat_MagicBarYOffset(void) {
+    return 0;
+}
