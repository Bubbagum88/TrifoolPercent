+++ b/soh/src/overlays/misc/ovl_kaleido_scope/z_kaleido_collect.c
@@ -6,9 +6,16 @@
 #include "soh/Enhancements/game-interactor/GameInteractor_Hooks.h"
 #include <libultraship/bridge/consolevariablebridge.h>
 
+// TrifoolPercent Beat 2.1 (Sages' Charm medallions-on-C). Weak symbol so a
+// Shipwright build without the TrifoolPercent module still links; the module
+// provides the real implementation when it is compiled in.
+__attribute__((weak)) void TrifoolBeat_UpdateQuestEquipHook(PlayState* play) { (void)play; }
+
 extern const char* digitTextures[];
 
 void KaleidoScope_DrawQuestStatus(PlayState* play, GraphicsContext* gfxCtx) {
+    // TrifoolPercent Beat 2.1: equip medallion to C-button on C-press.
+    TrifoolBeat_UpdateQuestEquipHook(play);
 
